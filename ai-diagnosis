<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>無料AI導入診断 | JS PROJECT</title>
<meta name="description" content="5つの質問に答えるだけ。あなたの職場にAIがどう使えるか、今すぐ診断結果がわかります。JS PROJECT 山口。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Serif+JP:wght@300;400;600&family=DM+Mono:wght@300;400;500&family=Yomogi&family=Zen+Kurenaido&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f7f0ec;--cream:#fdf8f5;--navy:#1c2a5e;--navy-lt:#2d3f7a;
  --gold:#c9a96e;--gold-lt:#e8cfa0;--blush:#eecfc0;--rose:#c9705a;
  --sage:#7a9e8e;--sage-lt:#c2ddd5;--text:#2a1f1a;--mid:#6b5248;
  --soft:#9b8880;--rule:rgba(201,169,110,0.18);--rule-s:rgba(122,158,142,0.2);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Noto Serif JP',serif;background:var(--bg);color:var(--text);overflow-x:hidden;min-height:100vh}
body::before{
  content:'';position:fixed;inset:0;
  background-image:linear-gradient(rgba(122,158,142,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(122,158,142,.04) 1px,transparent 1px);
  background-size:52px 52px;pointer-events:none;z-index:0;
}
.blob{position:fixed;border-radius:40% 60% 55% 45%/50% 40% 60% 50%;opacity:.15;filter:blur(2px);pointer-events:none;z-index:0;animation:blobFloat 12s ease-in-out infinite}
.blob-gold{background:linear-gradient(135deg,var(--gold-lt),var(--gold))}
.blob-sage{background:linear-gradient(135deg,var(--sage-lt),var(--sage))}
.b1{width:200px;height:160px;top:5%;right:5%;animation-delay:0s}
.b2{width:140px;height:120px;bottom:10%;left:3%;animation-delay:-6s}
@keyframes blobFloat{0%,100%{transform:translateY(0) rotate(0deg) scale(1)}40%{transform:translateY(-16px) rotate(5deg) scale(1.04)}70%{transform:translateY(10px) rotate(-3deg) scale(.97)}}

nav{position:relative;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:1.2rem 3rem;background:rgba(247,240,236,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--rule)}
.nav-logo{font-family:'DM Mono',monospace;font-size:.74rem;letter-spacing:.16em;color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:.6rem}
.nav-tag{font-size:.46rem;letter-spacing:.2em;color:var(--gold);border:1px solid var(--gold);padding:.1rem .45rem}
.nav-back{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.12em;color:var(--soft);text-decoration:none;text-transform:uppercase;display:flex;align-items:center;gap:.5rem;transition:color .2s}
.nav-back:hover{color:var(--navy)}

.hero{position:relative;z-index:1;text-align:center;padding:5rem 2rem 3rem}
.hero-eyebrow{font-family:'DM Mono',monospace;font-size:.52rem;letter-spacing:.3em;color:var(--sage);text-transform:uppercase;margin-bottom:1.4rem;display:flex;align-items:center;justify-content:center;gap:1rem}
.hero-eyebrow::before,.hero-eyebrow::after{content:'';width:24px;height:1px;background:var(--sage)}
.hero-h1{font-family:'Yomogi',cursive;font-size:clamp(2rem,5vw,3.6rem);color:var(--navy);line-height:1.3;margin-bottom:1rem}
.hero-h1 em{font-style:normal;color:var(--rose)}
.hero-sub{font-size:.88rem;color:var(--mid);line-height:1.9;margin-bottom:2rem;max-width:480px;margin-left:auto;margin-right:auto}

.steps{display:flex;align-items:center;justify-content:center;margin-bottom:3rem}
.step-dot{width:32px;height:32px;border-radius:50%;border:2px solid var(--rule);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:.58rem;color:var(--soft);transition:all .35s;background:var(--cream);position:relative;z-index:1}
.step-dot.active{border-color:var(--sage);color:var(--sage);box-shadow:0 0 0 4px rgba(122,158,142,.12)}
.step-dot.done{border-color:var(--sage);background:var(--sage);color:#fff}
.step-line{width:40px;height:1px;background:var(--rule);transition:background .35s}
.step-line.done{background:var(--sage)}

.card-wrap{position:relative;z-index:1;max-width:580px;margin:0 auto;padding:0 20px 6rem}
.progress-wrap{height:3px;background:var(--rule);border-radius:2px;margin-bottom:2rem;overflow:hidden}
.progress-bar{height:100%;background:linear-gradient(90deg,var(--sage),var(--gold));border-radius:2px;transition:width .45s ease}

.card{background:var(--cream);border:1px solid var(--rule);border-radius:8px;padding:2.8rem 2.4rem;box-shadow:0 24px 64px rgba(28,42,94,.07);position:relative}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--sage),var(--gold));border-radius:8px 8px 0 0}

.q-num{font-family:'DM Mono',monospace;font-size:.5rem;letter-spacing:.24em;color:var(--sage);text-transform:uppercase;margin-bottom:1rem}
.q-text{font-size:1.1rem;font-weight:600;color:var(--navy);line-height:1.65;margin-bottom:.5rem}
.q-sub{font-size:.78rem;color:var(--soft);margin-bottom:2rem;line-height:1.7}

.choices{display:flex;flex-direction:column;gap:.75rem;margin-bottom:2rem}
.choice{display:flex;align-items:center;gap:1rem;padding:1rem 1.2rem;border:1px solid var(--rule);border-radius:5px;cursor:pointer;transition:all .22s;background:var(--bg);font-size:.85rem;color:var(--text);line-height:1.5;-webkit-tap-highlight-color:transparent;user-select:none}
.choice:hover{border-color:var(--sage);background:#fff}
.choice.selected{border-color:var(--sage);background:#fff;box-shadow:0 0 0 3px rgba(122,158,142,.15)}
.choice-mark{width:22px;height:22px;border-radius:50%;border:2px solid var(--rule);flex-shrink:0;display:flex;align-items:center;justify-content:center;transition:all .22s}
.choice.selected .choice-mark{border-color:var(--sage);background:var(--sage)}
.choice.selected .choice-mark::after{content:'✓';font-size:11px;color:#fff;font-weight:700}

.btn-row{display:flex;gap:.8rem;justify-content:flex-end;align-items:center}
.btn-next{background:var(--navy);color:#fff;padding:.85rem 2rem;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;border:none;border-radius:3px;cursor:pointer;transition:all .25s;opacity:.35;pointer-events:none}
.btn-next.ready{opacity:1;pointer-events:all}
.btn-next.ready:hover{background:var(--navy-lt);transform:translateY(-2px);box-shadow:0 8px 24px rgba(28,42,94,.2)}
.btn-back{background:none;border:1px solid var(--rule);color:var(--soft);padding:.85rem 1.4rem;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;border-radius:3px;cursor:pointer;transition:all .22s}
.btn-back:hover{border-color:var(--mid);color:var(--mid)}

#result-section{display:none;position:relative;z-index:1}
.result-hero{text-align:center;padding:4rem 2rem 2rem}
.result-badge{display:inline-flex;align-items:center;gap:.5rem;background:var(--navy);color:#fff;font-family:'DM Mono',monospace;font-size:.5rem;letter-spacing:.18em;padding:.5rem 1.2rem;border-radius:2px;margin-bottom:1.8rem;text-transform:uppercase}
.result-h1{font-family:'Yomogi',cursive;font-size:clamp(1.8rem,5vw,3.2rem);color:var(--navy);line-height:1.3;margin-bottom:1rem}
.result-h1 em{font-style:normal;color:var(--rose)}

.result-wrap{max-width:600px;margin:0 auto;padding:0 20px 6rem}
.result-card{background:var(--cream);border:1px solid var(--rule);border-radius:8px;padding:2.8rem 2.4rem;box-shadow:0 24px 64px rgba(28,42,94,.07);position:relative}
.result-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--sage),var(--gold));border-radius:8px 8px 0 0}

.score-wrap{text-align:center;margin-bottom:2rem;padding:2rem;background:var(--bg);border-radius:6px;border:1px solid var(--rule-s)}
.score-num{font-family:'DM Mono',monospace;font-size:4.5rem;color:var(--sage);line-height:1;letter-spacing:-.03em;margin-bottom:.3rem}
.score-label{font-family:'DM Mono',monospace;font-size:.52rem;letter-spacing:.14em;color:var(--soft);text-transform:uppercase;margin-bottom:1.2rem}
.score-bar-wrap{height:6px;background:var(--rule);border-radius:3px;overflow:hidden}
.score-bar{height:100%;background:linear-gradient(90deg,var(--sage),var(--gold));border-radius:3px;transition:width 1s ease .3s}

.result-msg{font-size:.86rem;color:var(--text);line-height:2;margin-bottom:1.8rem;padding:1.4rem 1.6rem;background:var(--bg);border-radius:5px;border-left:3px solid var(--sage)}
.result-items{list-style:none;display:flex;flex-direction:column;gap:.8rem;margin-bottom:2rem}
.result-item{font-size:.82rem;color:var(--mid);display:flex;align-items:flex-start;gap:.8rem;padding:1rem 1.2rem;background:var(--bg);border-radius:5px;border:1px solid var(--rule-s);line-height:1.65}
.result-item::before{content:'✦';color:var(--sage);flex-shrink:0;font-size:.65rem;margin-top:.2rem}

.cta-section{border-top:1px solid var(--rule);padding-top:2rem;margin-top:.5rem}
.cta-label{font-family:'DM Mono',monospace;font-size:.5rem;letter-spacing:.22em;color:var(--sage);text-transform:uppercase;margin-bottom:.8rem;text-align:center}
.cta-note{font-size:.78rem;color:var(--soft);text-align:center;line-height:1.8;margin-bottom:1.4rem}
.line-btn{display:flex;align-items:center;justify-content:center;gap:.85rem;background:#06C755;color:#fff;padding:1.1rem 2rem;font-size:.9rem;font-weight:600;text-decoration:none;border-radius:4px;transition:all .28s;letter-spacing:.02em;width:100%}
.line-btn:hover{background:#05B04C;transform:translateY(-2px);box-shadow:0 10px 28px rgba(6,199,85,.28)}
.line-btn svg{width:20px;height:20px;fill:#fff;flex-shrink:0}
.retry-btn{display:block;text-align:center;margin-top:1rem;font-family:'DM Mono',monospace;font-size:.56rem;letter-spacing:.12em;color:var(--soft);cursor:pointer;background:none;border:none;width:100%;text-transform:uppercase;transition:color .2s;padding:.5rem}
.retry-btn:hover{color:var(--navy)}

.fade-in{animation:fadeUp .55s ease forwards}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

footer{position:relative;z-index:1;background:var(--navy);padding:1.8rem 3rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}
.ft-logo{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.2em;color:rgba(255,255,255,.8);text-transform:uppercase}
.ft-sub{font-family:'DM Mono',monospace;font-size:.44rem;letter-spacing:.12em;color:rgba(255,255,255,.28);margin-top:3px}
.ft-copy{font-family:'DM Mono',monospace;font-size:.44rem;color:rgba(255,255,255,.22);letter-spacing:.1em}

@media(max-width:600px){
  nav{padding:1rem 1.5rem}
  .hero{padding:3rem 1.5rem 2rem}
  .card-wrap,.result-wrap{padding:0 16px 4rem}
  .card,.result-card{padding:2rem 1.6rem}
  footer{padding:1.5rem;flex-direction:column;text-align:center}
}
</style>
</head>
<body>

<div class="blob blob-gold b1"></div>
<div class="blob blob-sage b2"></div>

<nav>
  <a href="https://jsproject.jp/" class="nav-logo">JS PROJECT <span class="nav-tag">YAMAGUCHI</span></a>
  <a href="https://jsproject.jp/" class="nav-back">← サイトに戻る</a>
</nav>

<div class="hero" id="formHero">
  <div class="hero-eyebrow">AI Consulting · 無料診断</div>
  <h1 class="hero-h1">あなたの職場に、<br><em>AIは使えるか？</em></h1>
  <p class="hero-sub">5つの質問に答えるだけ。<br>今すぐ診断結果とAI活用のヒントがわかります。</p>
  <div class="steps" id="stepIndicator">
    <div class="step-dot active" id="dot-1">1</div>
    <div class="step-line" id="line-1"></div>
    <div class="step-dot" id="dot-2">2</div>
    <div class="step-line" id="line-2"></div>
    <div class="step-dot" id="dot-3">3</div>
    <div class="step-line" id="line-3"></div>
    <div class="step-dot" id="dot-4">4</div>
    <div class="step-line" id="line-4"></div>
    <div class="step-dot" id="dot-5">5</div>
  </div>
</div>

<div class="card-wrap" id="formSection">
  <div class="progress-wrap">
    <div class="progress-bar" id="progressBar" style="width:20%"></div>
  </div>
  <div class="card fade-in" id="questionCard">
    <div class="q-num" id="qNum">Question 01 / 05</div>
    <div class="q-text" id="qText"></div>
    <div class="q-sub" id="qSub"></div>
    <div class="choices" id="choicesWrap"></div>
    <div class="btn-row">
      <button class="btn-back" id="btnBack" style="display:none" onclick="goBack()">← 戻る</button>
      <button class="btn-next" id="btnNext" onclick="goNext()">
        <span id="btnLabel">次の質問へ →</span>
      </button>
    </div>
  </div>
</div>

<div id="result-section">
  <div class="result-hero">
    <div class="result-badge">🤖 診断結果</div>
    <h1 class="result-h1" id="resultTitle"></h1>
  </div>
  <div class="result-wrap">
    <div class="result-card fade-in">
      <div class="score-wrap">
        <div class="score-num" id="resultScore">0%</div>
        <div class="score-label">AI活用ポテンシャル</div>
        <div class="score-bar-wrap">
          <div class="score-bar" id="scoreBar" style="width:0%"></div>
        </div>
      </div>
      <div class="result-msg" id="resultMsg"></div>
      <ul class="result-items" id="resultItems"></ul>
      <div class="cta-section">
        <div class="cta-label">次のステップ</div>
        <p class="cta-note">診断結果をLINEでお送りします。<br>具体的な導入プランを一緒に考えましょう。</p>
        <a href="https://lin.ee/Uiy7pq6" class="line-btn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.243c0 4.018 2.524 7.456 6.174 8.933l-.39 1.434c-.036.134.015.277.131.359a.336.336 0 0 0 .37.011l1.681-1.002c.67.117 1.357.178 2.034.178 5.523 0 10-4.145 10-9.913C22 6.145 17.523 2 12 2zm-3.08 12.875H7.052V9.344h1.868v5.531zm3.71 0h-1.815v-3.578l-1.78 3.578H9.21V9.344h1.815v3.506l1.755-3.506h1.85v5.531zm4.456-4.022h-1.813v.849h1.813v1.513h-1.813v.849h1.813v1.511h-3.327V9.344h3.327v1.509z"/></svg>
          LINEで結果を受け取る・相談する
        </a>
        <button class="retry-btn" onclick="resetDiagnosis()">もう一度診断する</button>
      </div>
    </div>
  </div>
</div>

<footer>
  <div>
    <div class="ft-logo">JS Project</div>
    <div class="ft-sub">AI Consulting & Web Production · YAMAGUCHI</div>
  </div>
  <div class="ft-copy">© 2025 JS PROJECT</div>
</footer>

<script>
const questions = [
  {
    text:"業種を教えてください",
    sub:"一番近いものを選んでください",
    choices:["士業（司法書士・行政書士・税理士など）","不動産会社・管理会社","飲食店・カフェ・飲食系","小売・サービス業・サロン","その他の中小企業・個人事業"],
    scores:[3,3,2,2,2]
  },
  {
    text:"毎週どのくらい「繰り返し作業」がありますか？",
    sub:"同じような書類作成・メール返信・データ入力など",
    choices:["ほぼ毎日ある（週5日以上）","週3〜4日程度ある","週1〜2日程度ある","あまりない"],
    scores:[3,2,1,0]
  },
  {
    text:"書類やファイルの管理はどうですか？",
    sub:"探すのに時間がかかることはありますか？",
    choices:["探すのに時間がかかることがよくある","たまに迷子になる","ある程度整理できている","完全に整理されている"],
    scores:[3,2,1,0]
  },
  {
    text:"お客様・依頼人への連絡対応はどうですか？",
    sub:"メール・電話・LINEなどの対応について",
    choices:["毎回文章を考えるのが大変","テンプレートはあるが手間がかかる","ある程度こなせている","特に問題ない"],
    scores:[3,2,1,0]
  },
  {
    text:"AIツールを使ったことはありますか？",
    sub:"ChatGPTやCopilotなどのAIアシスタント",
    choices:["まったく使ったことがない","少し試したが使いこなせていない","時々使っているが業務には活かせていない","日常的に活用している"],
    scores:[1,2,3,1]
  }
];

let current=0, answers=[], totalScore=0;

function renderQuestion(){
  const q=questions[current];
  document.getElementById('qNum').textContent=`Question ${String(current+1).padStart(2,'0')} / 05`;
  document.getElementById('qText').textContent=q.text;
  document.getElementById('qSub').textContent=q.sub;

  const wrap=document.getElementById('choicesWrap');
  wrap.innerHTML='';
  q.choices.forEach((c,i)=>{
    const div=document.createElement('div');
    div.className='choice'+(answers[current]===i?' selected':'');
    div.innerHTML=`<div class="choice-mark"></div><span>${c}</span>`;
    div.onclick=()=>selectChoice(i);
    wrap.appendChild(div);
  });

  document.getElementById('btnBack').style.display=current>0?'block':'none';
  document.getElementById('btnLabel').textContent=current===questions.length-1?'診断結果を見る →':'次の質問へ →';
  document.getElementById('btnNext').classList.toggle('ready',answers[current]!==undefined);
  document.getElementById('progressBar').style.width=((current+1)/questions.length*100)+'%';

  for(let i=1;i<=5;i++){
    const dot=document.getElementById('dot-'+i);
    const line=document.getElementById('line-'+i);
    dot.classList.remove('active','done');
    if(line)line.classList.remove('done');
    if(i-1<current){dot.classList.add('done');if(line)line.classList.add('done');}
    else if(i-1===current){dot.classList.add('active');}
  }

  const card=document.getElementById('questionCard');
  card.classList.remove('fade-in');
  void card.offsetWidth;
  card.classList.add('fade-in');
}

function selectChoice(idx){
  answers[current]=idx;
  document.querySelectorAll('.choice').forEach((el,i)=>el.classList.toggle('selected',i===idx));
  document.getElementById('btnNext').classList.add('ready');
}

function goNext(){
  if(answers[current]===undefined)return;
  totalScore+=questions[current].scores[answers[current]];
  if(current<questions.length-1){current++;renderQuestion();}
  else showResult();
}

function goBack(){
  if(current>0){totalScore-=questions[current-1].scores[answers[current-1]];current--;renderQuestion();}
}

function showResult(){
  document.getElementById('formHero').style.display='none';
  document.getElementById('formSection').style.display='none';

  const maxScore=questions.reduce((s,q)=>s+Math.max(...q.scores),0);
  const pct=Math.round(totalScore/maxScore*100);

  let title,msg,items;
  if(pct>=75){
    title='AIで、<em>大きく変われます。</em>';
    msg='繰り返し作業・書類管理・連絡対応など、AIで自動化できる業務が多数あります。導入することで週に数時間の時間を取り戻せる可能性が高いです。まず1〜2つの業務から始めてみましょう。';
    items=['書類・ファイル検索の自動化で「探す時間」をなくす','メール・返信文の自動下書きで連絡業務を半減','経費・交通費の入力自動化でミスと手間をなくす','あなたの業種に合った「専属AI」を一緒に構築できます'];
  }else if(pct>=45){
    title='AIを使えば、<em>もっと楽になれます。</em>';
    msg='現状でも改善できる余地が十分あります。特定の業務に絞ってAIを導入するだけで、日々の手間を大幅に削減できます。最初の一歩を一緒に考えましょう。';
    items=['まず1〜2つの業務に絞って試すのがおすすめ','メール返信・書類作成から始めると効果を実感しやすい','慣れてきたら範囲を広げていけます','モニタープランで最初の一手を一緒に考えます'];
  }else{
    title='AIで、<em>新しい可能性があります。</em>';
    msg='今は特に大きな課題を感じていないかもしれませんが、AIを知ることで「そんなことまでできるの？」という気づきが生まれることが多いです。まずは話を聞いてみてください。';
    items=['まずは30分の相談で可能性を一緒に確認しましょう','導入後に「もっと早く知りたかった」という声が多いです','費用対効果を含めて丁寧にご説明します','無理な営業は一切しません'];
  }

  document.getElementById('resultTitle').innerHTML=title;
  document.getElementById('resultScore').textContent=pct+'%';
  setTimeout(()=>{document.getElementById('scoreBar').style.width=pct+'%';},100);
  document.getElementById('resultMsg').textContent=msg;

  const ul=document.getElementById('resultItems');
  ul.innerHTML='';
  items.forEach(item=>{
    const li=document.createElement('li');
    li.className='result-item';
    li.textContent=item;
    ul.appendChild(li);
  });

  document.getElementById('result-section').style.display='block';
  window.scrollTo({top:0,behavior:'smooth'});
}

function resetDiagnosis(){
  current=0;answers=[];totalScore=0;
  document.getElementById('result-section').style.display='none';
  document.getElementById('formHero').style.display='block';
  document.getElementById('formSection').style.display='block';
  renderQuestion();
  window.scrollTo({top:0,behavior:'smooth'});
}

renderQuestion();
</script>
